// BLOQUE 9: Variable Global 
let estudiantes = [];

function iniciarSistema() {
    // BLOQUE 9: Variable Local 
    let opcion;

    do {
        opcion = prompt("Elige una opción del 1 al 6:\n1. Agregar estudiante\n2. Mostrar estudiantes\n3. Calcular promedio\n4. Buscar letra repetida\n5. Suma recursiva\n6. Salir");

        switch (opcion) {
            case "1":
                // Código que se ejecuta si la variable vale "1"
                    let idEstudiante = prompt("Ingrese el ID del estudiante:");
                    let nombre = prompt("Ingrese el nombre del estudiante:");
                    let edad = prompt("Ingrese la edad del estudiante:");
                    agregarEstudiante(idEstudiante, nombre, edad);
                break;
            case "2":
        console.log("=== LISTA COMPLETA DE ESTUDIANTES ===");
        if (estudiantes.length === 0) {
            console.log("No hay estudiantes registrados en la parrilla.");
        } else {
            for (let i = 0; i < estudiantes.length; i++) {
                estudiantes[i].mostrarInformacion(); 
            }
        }
                break;
            case "3":
                // Código si vale "3"
                let promedioId = prompt("Ingrese el ID del estudiante para calcular su promedio:");
                calcularPromedio(parseInt(promedioId));
                break;
            case "4":
                 // Código si vale "4"
                let idBusqueda = prompt("Ingrese el ID del estudiante para buscar letras repetidas:");
                let encontrado = false;

                for (let i = 0; i < estudiantes.length; i++) {
                    if (estudiantes[i].id === parseInt(idBusqueda)) {
                        buscarLetrasRepetidas(estudiantes[i].nombre);
                        encontrado = true;
                        break; 
                    }
                }

                if (!encontrado) {
                    console.error("No se encontró ningún estudiante con ese ID.");
                }
                break;
            case "5":
                // Código si vale "5"
                let num = prompt("¿Hasta qué número quieres sumar?");
                let n = parseInt(num);
                console.log("La suma recursiva es: " + sumaHastaN(n));
            case "6":
                // Código si vale "6"
                break;
            default:
                // Código que se ejecuta si no coincide con ninguno
                break;
        }
    } while (opcion !== "6"); // Si no es un 6, volvemos a mostrar el menú
}
function agregarEstudiante(id, nombre, edad) {
    try {
        id = parseInt(id);
        nombre = String(nombre);
        edad = parseInt(edad);

        if(nombre === "") throw new Error("El nombre no puede estar vacío");
        if (edad <= 0) throw new Error("La edad debe ser un número positivo");
        if (isNaN(id)) throw new Error("El ID debe ser un número válido");

        for (let i = 0; i < estudiantes.length; i++) {
            if (estudiantes[i].id === id) {
                throw new Error("Ya existe un estudiante con ese ID");
            }
        }

        let nuevoEstudiante = {
            id: id,
            nombre: nombre,
            edad: edad,
            notas: [] 
            // bloque 7
            mostrarInformacion: function() {
                console.log(`ID: ${this.id}, Nombre: ${this.nombre}, Edad: ${this.edad}, Notas: ${this.notas.length > 0 ? this.notas.join(", ") : "Sin registros"}`);
        }
        };
        estudiantes.push(nuevoEstudiante);
        console.log("¡Piloto registrado con éxito!");

    } catch (error) {
        console.error("Error al agregar estudiante:", error.message);
    } finally {
        console.log("Intento de registro finalizado");
    }
}
function agregarNota(id, nota) {
    if (nota < 0 || nota > 10) {
        console.error("La nota debe estar entre 0 y 10");
        return;
    }
    for (let i = 0; i < estudiantes.length; i++) {
        if (estudiantes[i].id === id) {
            console.log("Estudiante encontrado, agregando nota...");
            estudiantes[i].notas.push(nota);
            console.log("Nota agregada exitosamente");
            return;
        }
}
    console.error("ERROR: Estudiante no encontrado");
}
function calcularPromedio(idEstudiante) {
    for (let i = 0; i < estudiantes.length; i++) {
        if (estudiantes[i].id === idEstudiante) {
            let notasAlumno = estudiantes[i].notas;
            if (notasAlumno.length === 0) {
                console.log("El estudiante no tiene notas registradas");
                return;
            }
            let suma = 0;
            for (let j = 0; j < notasAlumno.length; j++) {
                suma += notasAlumno[j];
            }
            let promedio = suma / notasAlumno.length;
            if (promedio < 5) {
                console.log("Estado: Suspende");
            } else if (promedio > 5 && promedio < 9) {
                console.log("Estado: Aprobado");
                } else {
                    console.log("Estado: Excelente");
                }
                console.log(`El promedio del estudiante ${estudiantes[i].nombre} es: ${promedio.toFixed(2)}`);
            }
            return;
        }
    
    console.error("ERROR: Estudiante no encontrado");
}
function primeraLetraRepetida(nombre) {
    if (typeof nombre !== 'string') {
        console.log("El valor introducido no es un texto válido.");
        return;
    }

    let nombreLimpio = nombre.toLowerCase().replace(/\s+/g, '');
    
    for (let i = 0; i < nombreLimpio.length; i++) {
        let letraActual = nombreLimpio[i];
        for (let j = i + 1; j < nombreLimpio.length; j++) {
            if (letraActual === nombreLimpio[j]) {
                console.log(`La primera letra repetida es: ${letraActual}`);
                return letraActual; // Con return salimos inmediatamente al encontrar la primera
            }
        }
    }
    console.log(`El nombre "${nombre}" no tiene letras repetidas.`);
}
function sumaHastaN(n) {
    if (isNaN(n) || n < 1) {
        console.log("El número debe ser un entero positivo mayor que 0.");
        return 0;
    }

    if (n === 1) {
        return 1;
    } else {
        return n + sumaHastaN(n - 1);
    }
}
// BLOQUE 8: Manipulación Avanzada de Arrays
function mostrarEstudiantesDestacados() {
    let destacados = estudiantes.filter(estudiante => {
        if (estudiante.notas.length === 0) return false;
        
        let suma = 0;
        for (let i = 0; i < estudiante.notas.length; i++) {
            suma += estudiante.notas[i];
        }
        let promedio = suma / estudiante.notas.length;
        return promedio >= 9;
    });

    if (destacados.length > 0) {
        console.log("Estudiantes destacados: " + destacados.map(estudiante => estudiante.nombre).join(", "));
    } else {
        console.log("No hay estudiantes destacados.");
    }
}
